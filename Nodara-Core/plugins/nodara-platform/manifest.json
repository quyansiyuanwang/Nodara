{
  "id": "nodara.windows.platform",
  "name": "Nodara Windows Platform",
  "version": "2.0.0",
  "protocol_version": "1",
  "executable": "nodara-platform-plugin.exe",
  "description": "Official host automation: keyboard, mouse, windows, screen capture and clipboard.",
  "author": "Nodara Contributors",
  "capabilities": [
    "Input.Keyboard",
    "Input.Mouse",
    "Window.Find",
    "Window.Focus",
    "Window.Capture",
    "Desktop.Capture",
    "Clipboard.Read",
    "Clipboard.Write"
  ],
  "permissions": [
    "input.control",
    "window.control",
    "screen.capture",
    "clipboard"
  ],
  "node_types": [
    "windows.Input.Keyboard",
    "windows.Input.Mouse",
    "windows.Input.Text",
    "windows.Window.Find",
    "windows.Window.Focus",
    "windows.Window.Capture",
    "windows.Desktop.Capture",
    "system.Clipboard"
  ],
  "features": [
    {
      "id": "input",
      "name": "Keyboard, mouse and text input",
      "kind": "integration",
      "description": "Foreground keyboard, mouse and text automation.",
      "capabilities": ["Input.Keyboard", "Input.Mouse"],
      "permissions": ["input.control"],
      "node_types": [
        "windows.Input.Keyboard",
        "windows.Input.Mouse",
        "windows.Input.Text"
      ]
    },
    {
      "id": "windows",
      "name": "Window and screen integration",
      "kind": "integration",
      "description": "Window lookup, focus, window capture and desktop capture.",
      "capabilities": [
        "Window.Find",
        "Window.Focus",
        "Window.Capture",
        "Desktop.Capture"
      ],
      "permissions": ["window.control", "screen.capture"],
      "node_types": [
        "windows.Window.Find",
        "windows.Window.Focus",
        "windows.Window.Capture",
        "windows.Desktop.Capture"
      ]
    },
    {
      "id": "clipboard",
      "name": "Clipboard integration",
      "kind": "integration",
      "capabilities": ["Clipboard.Read", "Clipboard.Write"],
      "permissions": ["clipboard"],
      "node_types": ["system.Clipboard"]
    }
  ]
}
