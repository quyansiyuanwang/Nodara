{
  "$schema": "../RecognizerFramework/schema/workflow.schema.json",
  "schema_version": "2.0",
  "id": "workflow.branching",
  "metadata": {
    "name": "Branching",
    "description": "Uses edge guards to route on a computed score."
  },
  "nodes": [
    { "id": "start", "type": "core.Start" },
    {
      "id": "score",
      "type": "core.Calculate",
      "config": { "expression": "retries * 3", "output_var": "score" }
    },
    {
      "id": "high",
      "type": "core.Log",
      "config": { "message": "score {{score}} is high", "level": "warn" }
    },
    {
      "id": "low",
      "type": "core.Log",
      "config": { "message": "score {{score}} is low" }
    },
    { "id": "end", "type": "core.End" }
  ],
  "edges": [
    { "id": "e1", "source": "start", "target": "score" },
    {
      "id": "e2",
      "source": "score",
      "target": "high",
      "condition": "score > 5"
    },
    {
      "id": "e3",
      "source": "score",
      "target": "low",
      "condition": "score <= 5"
    },
    { "id": "e4", "source": "high", "target": "end" },
    { "id": "e5", "source": "low", "target": "end" }
  ],
  "variables": {
    "retries": { "value": 3, "description": "Number of attempts so far." }
  }
}
