{
  "$schema": "../Nodara-Core/schema/workflow.schema.json",
  "schema_version": "2.1",
  "id": "workflow.system-command",
  "metadata": {
    "name": "Run a command",
    "description": "Launch a command, publish its stdout and log the captured result.",
    "tags": [
      "system",
      "command",
      "example"
    ]
  },
  "nodes": [
    {
      "id": "start",
      "type": "core.Start",
      "label": "Start",
      "config": {},
      "position": {
        "x": 80,
        "y": 80
      }
    },
    {
      "id": "command",
      "type": "system.Command",
      "label": "Run command",
      "config": {
        "program": "echo Hello from the Nodara command node",
        "args": [],
        "shell": true,
        "check_exit_code": true,
        "wait": true
      },
      "result_var": "command_output",
      "result_port": "out",
      "position": {
        "x": 340,
        "y": 80
      }
    },
    {
      "id": "log",
      "type": "core.Log",
      "label": "Log captured output",
      "config": {
        "level": "info",
        "message": "{{command_output}}"
      },
      "position": {
        "x": 620,
        "y": 80
      }
    },
    {
      "id": "end",
      "type": "core.End",
      "label": "End",
      "config": {
        "code": 0
      },
      "position": {
        "x": 880,
        "y": 80
      }
    }
  ],
  "edges": [
    {
      "id": "start-command",
      "source": "start",
      "target": "command",
      "kind": "control"
    },
    {
      "id": "command-log",
      "source": "command",
      "target": "log",
      "kind": "control"
    },
    {
      "id": "log-end",
      "source": "log",
      "target": "end",
      "kind": "control"
    }
  ],
  "variables": {}
}
